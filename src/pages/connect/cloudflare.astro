---
import "../../styles/site.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Connecting Cloudflare · Serve</title>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0d" />
    {/* Same theme rule as the rest of the site. */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("starlight-theme");
        } catch {}
        const theme = stored === "light" || stored === "dark" ? stored : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <style>
      .link {
        position: relative;
        width: 7rem;
        height: 2px;
        background: repeating-linear-gradient(90deg, var(--line-strong) 0 6px, transparent 6px 12px);
      }
      .link::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        width: 8px;
        height: 8px;
        margin-top: -4px;
        border-radius: 999px;
        background: var(--accent);
        box-shadow: 0 0 12px var(--accent);
        animation: travel 1.4s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
      }
      [data-state="error"] .link::after {
        animation: none;
        left: calc(50% - 4px);
        background: var(--bad);
        box-shadow: 0 0 12px var(--bad);
      }
      [data-state="idle"] .link::after {
        animation: none;
        left: calc(50% - 4px);
        background: var(--line-strong);
        box-shadow: none;
      }
      @keyframes travel {
        to {
          left: calc(100% - 8px);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .link::after {
          animation: none;
          left: calc(50% - 4px);
        }
      }
      .tile {
        display: flex;
        width: 4rem;
        height: 4rem;
        flex: none;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--line);
        border-radius: 1.1rem;
        background: var(--surface);
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
      }
      .logo-dark {
        display: none;
      }
      :root[data-theme="dark"] .logo-dark {
        display: block;
      }
      :root[data-theme="dark"] .logo-light {
        display: none;
      }
    </style>
  </head>
  <body class="min-h-screen">
    <main id="page" data-state="working" class="flex min-h-screen flex-col items-center justify-center px-4 py-16 text-center">
      <div class="flex items-center gap-4" aria-hidden="true">
        <span class="tile">
          <img src="/img/logo-light.svg" alt="" width="36" height="36" class="logo-light" />
          <img src="/img/logo-dark.svg" alt="" width="36" height="36" class="logo-dark" />
        </span>
        <span class="link"></span>
        <span class="tile">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#f38020" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
          </svg>
        </span>
      </div>
      <p class="mt-8 font-mono text-[12px] tracking-wide text-faint uppercase">Serve <span class="px-1">×</span> Cloudflare</p>
      <h1 id="title" class="mt-3 text-2xl font-semibold text-fg sm:text-3xl">Connecting Cloudflare</h1>
      <p id="text" class="mt-3 max-w-sm text-[15px] leading-relaxed text-muted">One moment.</p>
      <noscript><p class="mt-3 max-w-sm text-[15px] text-muted">This page needs JavaScript to return you to your dashboard.</p></noscript>
      <a id="help" href="/docs/cloudflare/" class="mt-8 hidden text-[13px] text-accent underline-offset-4 hover:underline">How connecting Cloudflare works</a>
    </main>

    <script is:inline>
      // Cloudflare can only return to registered addresses, and every Serve instance has its own.
      // So Serve sends the browser here first: this page remembers where to return, in this
      // browser only, then goes on to Cloudflare. When Cloudflare comes back here, the browser is
      // sent on to that same dashboard. A sign-in this browser did not start goes nowhere.
      (() => {
        const RELAY = "https://serve.bd/connect/cloudflare";
        const PREFIX = "serve-cf:";
        const TTL = 30 * 60 * 1000;
        const q = new URLSearchParams(location.search);
        const page = document.getElementById("page");
        const show = (title, text, state = "error") => {
          page.dataset.state = state;
          document.getElementById("title").textContent = title;
          document.getElementById("text").textContent = text;
          document.getElementById("help").classList.toggle("hidden", state === "working");
        };
        const store = (() => {
          for (const name of ["localStorage", "sessionStorage"]) {
            try {
              const s = window[name];
              s.setItem(`${PREFIX}test`, "1");
              s.removeItem(`${PREFIX}test`);
              return s;
            } catch {}
          }
          return null;
        })();
        if (!store) return show("Cannot connect here", "This browser blocks site storage, which this step needs. Allow it for serve.bd, or paste an API token in Serve instead.");
        // Forget sign-ins that never came back.
        for (let i = store.length - 1; i >= 0; i--) {
          const key = store.key(i);
          if (!key?.startsWith(PREFIX)) continue;
          try {
            if (JSON.parse(store.getItem(key)).exp < Date.now()) store.removeItem(key);
          } catch {
            store.removeItem(key);
          }
        }

        // 1. From a Serve dashboard, on the way to Cloudflare.
        if (q.has("auth") && q.has("return")) {
          let auth;
          let back;
          try {
            auth = new URL(q.get("auth"));
            back = new URL(q.get("return"));
          } catch {
            return show("Link not valid", "Start again from the Cloudflare page in Serve.");
          }
          const state = auth.searchParams.get("state");
          const ok =
            auth.origin === "https://dash.cloudflare.com" &&
            auth.pathname === "/oauth2/auth" &&
            auth.searchParams.get("redirect_uri") === RELAY &&
            state &&
            /^https?:$/.test(back.protocol) &&
            back.pathname.endsWith("/api/cloudflare/oauth/callback") &&
            !back.search &&
            !back.username &&
            !back.password;
          if (!ok) return show("Link not valid", "Start again from the Cloudflare page in Serve.");
          store.setItem(PREFIX + state, JSON.stringify({ back: back.toString(), exp: Date.now() + TTL }));
          show("Connecting Cloudflare", "Taking you to Cloudflare to sign in.", "working");
          return location.replace(auth.toString());
        }

        // 2. Back from Cloudflare, on the way to the dashboard that started it.
        const state = q.get("state");
        if (state && (q.has("code") || q.has("error"))) {
          const saved = store.getItem(PREFIX + state);
          store.removeItem(PREFIX + state);
          let back;
          try {
            back = JSON.parse(saved)?.back;
          } catch {}
          if (!back)
            return show("Start from your dashboard", "This browser did not start this sign-in, or it took longer than 30 minutes. Start again from the Cloudflare page in Serve.");
          const url = new URL(back);
          for (const key of ["code", "state", "error", "error_description"]) if (q.has(key)) url.searchParams.set(key, q.get(key));
          try {
            // The code stays out of this page's history.
            history.replaceState(null, "", location.pathname);
          } catch {}
          show("Connecting Cloudflare", `Taking you back to ${url.host}.`, "working");
          return location.replace(url.toString());
        }

        show("Connect Cloudflare", "Open the Cloudflare page in your Serve dashboard and choose Sign in with Cloudflare.", "idle");
      })();
    </script>
  </body>
</html>
