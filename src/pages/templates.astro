---
import { ArrowRight, MessageSquarePlus } from "lucide-react";
import { buttonVariants } from "@/components/react/ui/button";
import { TemplateCatalog } from "@/components/react/template-catalog";
import Site from "@/layouts/Site.astro";
import { community } from "@/lib/site";
import { categories, templates } from "@/lib/templates";
---

<Site title="Templates" description={`${templates.length} one-click services for Serve: analytics, automation, CMS, storage, AI and more.`}>
  <div class="mx-auto max-w-6xl px-4 pt-16 pb-24 sm:px-6 sm:pt-20">
    <div class="mb-8 max-w-2xl">
      <p class="mb-3 font-mono text-[12px] tracking-wide text-accent uppercase">Templates</p>
      <h1 class="text-4xl font-semibold tracking-tight text-fg sm:text-5xl">{templates.length} services, one click each.</h1>
      <p class="mt-4 text-[16px] leading-relaxed text-muted">
        Each template comes with its domain, secrets and volumes set up. New templates reach every Serve install without an update.{" "}
        <a href="/docs/templates/" class="inline-flex items-center gap-1 text-accent hover:underline">Make your own <ArrowRight className="size-3.5" /></a>
      </p>
    </div>
    <TemplateCatalog client:load templates={templates} categories={categories} requestUrl={community.templateRequest} />
    <div class="mt-16 flex flex-col items-start justify-between gap-5 rounded-2xl border border-line bg-surface p-6 sm:flex-row sm:items-center sm:p-8">
      <div>
        <h2 class="text-xl font-semibold text-fg">Missing an app? Ask for it.</h2>
        <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-muted">
          Tell us the app, its website and its Docker image. Or add it yourself with a pull request:
          <a href={community.templatesGuide} target="_blank" rel="noreferrer" class="text-accent hover:underline">the template guide</a> explains the format.
        </p>
      </div>
      <a href={community.templateRequest} target="_blank" rel="noreferrer" class={buttonVariants({ variant: "primary", size: "lg" })}>
        <MessageSquarePlus /> Request a template
      </a>
    </div>
  </div>
</Site>
