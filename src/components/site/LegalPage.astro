---
import Site from "@/layouts/Site.astro";
import { site } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  /** The date of the last change, like "3 October 2026". */
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Site title={title} description={description}>
  <article class="legal mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="mb-5 font-mono text-[12px] tracking-wide text-accent uppercase">Legal</p>
    <h1 class="text-[36px] leading-[1.1] font-semibold tracking-[-0.03em] text-balance text-fg sm:text-[44px]">{title}</h1>
    <p class="mt-4 text-[13px] text-faint">Last updated {updated}</p>
    <div class="mt-10">
      <slot />
    </div>
    <p class="mt-14 border-t border-line pt-6 text-sm text-muted">
      Questions? Write to <a href={`mailto:${site.contact}`}>{site.contact}</a>.
    </p>
  </article>
</Site>

<style>
  .legal :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 20px;
    font-weight: 600;
    color: var(--fg);
  }
  .legal :global(p),
  .legal :global(li) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--fg-2);
  }
  .legal :global(p + p) {
    margin-top: 0.75rem;
  }
  .legal :global(ul) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal :global(li + li) {
    margin-top: 0.375rem;
  }
  .legal :global(strong) {
    font-weight: 600;
    color: var(--fg);
  }
  .legal :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal :global(a:hover) {
    color: var(--accent-strong);
  }
</style>
