---
// The 2 minute demo. Only its thumbnail loads with the page: YouTube (its privacy mode, without
// cookies until played) comes in on the click, so the page stays light. Without JavaScript the
// thumbnail is a link to the video.
import { Picture } from "astro:assets";
import thumbnail from "@/assets/demo-thumbnail.png";
import { cn } from "@/lib/utils";
import { site } from "@/lib/site";

const { class: className } = Astro.props;
const title = "Serve: deploy apps and databases on your own servers (demo)";
const watch = `https://www.youtube.com/watch?v=${site.demoVideo}`;
---

<!-- not-content: the docs' text styles leave it alone (they add space around pictures). -->
<div class={cn("not-content overflow-hidden rounded-2xl border border-line-strong bg-surface p-1.5 shadow-lg", className)}>
  <div class="demo-video relative aspect-video overflow-hidden rounded-xl border border-line bg-black" data-id={site.demoVideo} data-title={title}>
    <a href={watch} target="_blank" rel="noreferrer" class="group absolute inset-0 block" aria-label={`Play: ${title}`}>
      <Picture src={thumbnail} alt="" formats={["avif", "webp"]} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 960px, 100vw" loading="lazy" class="h-full w-full object-cover" />
      <span class="absolute inset-0 bg-black/10 transition-colors group-hover:bg-black/0"></span>
      <span
        class="absolute top-1/2 left-1/2 flex size-[72px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-accent text-white shadow-xl ring-8 ring-white/15 transition-transform duration-200 group-hover:scale-105 group-focus-visible:scale-105"
      >
        <svg viewBox="0 0 24 24" class="ml-1 size-7" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14Z"></path></svg>
      </span>
    </a>
  </div>
</div>

<script>
  // The click plays it here, in YouTube's privacy mode, instead of opening YouTube.
  for (const box of document.querySelectorAll<HTMLElement>(".demo-video")) {
    box.querySelector("a")?.addEventListener("click", (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.id}?autoplay=1&rel=0&modestbranding=1`;
      frame.title = box.dataset.title ?? "Video";
      frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      frame.allowFullscreen = true;
      frame.className = "absolute inset-0 h-full w-full";
      box.replaceChildren(frame);
    });
  }
</script>
