---
import { cn } from "@/lib/utils";

const { eyebrow, title, center } = Astro.props;
---

<div class={cn("mb-12 max-w-2xl", center && "mx-auto text-center")}>
  {eyebrow && <p class="mb-3 font-mono text-[12px] tracking-wide text-accent uppercase">{eyebrow}</p>}
  <h2 class="text-3xl font-semibold text-balance text-fg sm:text-4xl">{title}</h2>
  {Astro.slots.has("default") && <p class="mt-4 text-[16px] leading-relaxed text-pretty text-muted"><slot /></p>}
</div>
