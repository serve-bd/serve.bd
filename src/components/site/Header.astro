---
import { GitHubMark } from "@/components/react/github-mark";
import { FeaturesMenu } from "@/components/react/features-menu";
import { MobileNav } from "@/components/react/mobile-nav";
import { ThemeToggle } from "@/components/react/theme-toggle";
import { buttonVariants } from "@/components/react/ui/button";
import { nav, site } from "@/lib/site";
import { cn } from "@/lib/utils";
import Mark from "../Mark.astro";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-glass backdrop-blur-xl backdrop-saturate-150">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a href="/" aria-label="Serve home" class="flex shrink-0 items-center gap-2">
      <Mark class="size-6" />
      <span class="font-display text-[17px] font-semibold tracking-tight text-fg">Serve</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) =>
          item.label === "Features" ? (
            <FeaturesMenu client:idle active={path.startsWith(item.href)} />
          ) : (
          <a
            href={item.href}
            {...(item.external ? { target: "_blank", rel: "noreferrer" } : {})}
            class={cn("rounded-md px-2.5 py-1.5 text-[13.5px] transition-colors hover:text-fg", path.startsWith(item.href) ? "text-fg" : "text-muted")}
          >
            {item.label}
          </a>
          ),
        )
      }
    </nav>
    <div class="ml-auto flex items-center gap-1.5">
      <a href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub" class={buttonVariants({ variant: "ghost", size: "icon" })}>
        <GitHubMark className="size-4" />
      </a>
      <ThemeToggle client:idle />
      <a href="/docs/installation/" class={cn(buttonVariants({ variant: "primary", size: "sm" }), "ml-1 hidden sm:inline-flex")}>Install</a>
      <MobileNav client:media="(max-width: 767px)" />
    </div>
  </div>
</header>
