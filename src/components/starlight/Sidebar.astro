---
// The docs sidebar as plain, always-open groups, like the old docs.
// Starlight's default folds groups shut, which hid pages.
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
// Saves the sidebar's scroll position and puts it back on the next page.
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";

const { sidebar } = Astro.locals.starlightRoute;
---

<SidebarPersister>
<nav class="docs-nav flex flex-col gap-6 pb-8 text-sm">
  {
    sidebar.map((entry) =>
      entry.type === "group" ? (
        <div>
          <h4 class="mb-2 px-2.5 text-[12px] font-medium text-faint">{entry.label}</h4>
          <ul class="flex flex-col gap-px">
            {entry.entries.map(
              (link) =>
                link.type === "link" && (
                  <li>
                    <a href={link.href} aria-current={link.isCurrent ? "page" : undefined} class:list={["docs-nav-link", { current: link.isCurrent }]}>
                      {link.label}
                    </a>
                  </li>
                ),
            )}
          </ul>
        </div>
      ) : (
        <a href={entry.href} aria-current={entry.isCurrent ? "page" : undefined} class:list={["docs-nav-link", { current: entry.isCurrent }]}>
          {entry.label}
        </a>
      ),
    )
  }
</nav>
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
